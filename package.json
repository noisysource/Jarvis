{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis, a personal AI orchestrator (KidClub + personal), for Google Cloud Run",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "jarvis": "tsx --env-file-if-exists=.env scripts/jarvis.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "smoke:llm": "tsx --env-file-if-exists=.env scripts/smoke-llm.ts",
    "eval:classifier": "tsx --env-file-if-exists=.env scripts/eval-classifier.ts",
    "eval:memory": "tsx --env-file-if-exists=.env scripts/eval-memory.ts",
    "eval:identity": "tsx --env-file-if-exists=.env scripts/eval-identity.ts",
    "calendar:connect": "tsx --env-file-if-exists=.env scripts/calendar-connect.ts",
    "gmail:connect": "tsx --env-file-if-exists=.env scripts/gmail-connect.ts",
    "github:connect": "tsx --env-file-if-exists=.env scripts/github-connect.ts",
    "memory:reflect": "tsx --env-file-if-exists=.env scripts/memory-reflect.ts",
    "memory": "tsx --env-file-if-exists=.env scripts/memory.ts",
    "voice:setup": "bash scripts/voice-setup.sh",
    "voice:up": "bash scripts/voice-up.sh",
    "voice:bench": "tsx --env-file-if-exists=.env scripts/voice-bench.ts",
    "ask": "tsx --env-file-if-exists=.env scripts/ask.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@google-cloud/secret-manager": "7.2.0",
    "@hono/node-server": "2.1.5",
    "@ricky0123/vad-web": "0.0.31",
    "hono": "4.13.13",
    "onnxruntime-web": "1.30.0",
    "undici": "6.29.1",
    "zod": "4.6.7"
  }
}
