# Local development only. Copy to .env (which is gitignored) and fill in.
# In production the key comes from Google Secret Manager and this file is ignored.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (defaults shown); see PLAN.md for the full list.
# PORT=8080
# CLASSIFIER_MODEL=anthropic:claude-haiku-5-5
# ANSWER_MODEL=anthropic:claude-sonnet-5-5
# PROFILE_SOURCE=file:data/profile.md
# MEMORY_STORE=sqlite        (or "memory": RAM only, lost on restart)
# MEMORY_DB=data/memory.sqlite
# Jarvis's voice (pick one on http://localhost:8080/voices, then set both):
# TTS_PROVIDER=browser       (or kokoro / piper, after npm run voice:setup and voice:up)
# TTS_VOICE=
# KOKORO_URL=http://127.0.0.1:8880   (must be on this machine)
# PIPER_URL=http://127.0.0.1:5001
# Jarvis's ears: whisper.cpp on this machine (npm run voice:setup and voice:up).
# WHISPER_URL=http://127.0.0.1:8178  (must be on this machine)
# The local brain (#88): Ollama on this machine. The chat page switches between Local and Claude.
# OLLAMA_URL=http://127.0.0.1:11434  (must be on this machine)
OLLAMA_MODEL=qwen3:8b
# OLLAMA_THINK=off          (on: the local model thinks before answering; slower to start talking)
# BARE_MODE=on              (every turn: only the EC precheck, then the brain with the history and a short persona)
# JARVIS_USER_NAME=          (your name for that persona; this file's copy, .env, is gitignored)
# WHISPER_HINTS_PATH=data/whisper-hints.txt   (names Whisper should expect; gitignored)
# Spoken conversation:
# VOICE_END_OF_TURN_MS=500   (silence that ends your turn, 200–3000)
# BARGE_IN_CHROME=strict     (vad: just talk to interrupt; strict: clearer speech needed; push: tap Interrupt / Space)
# BARGE_IN_SAFARI=strict
# BARGE_IN_OTHER=vad
# Latency (#76):
# VOICE_THINKING=off         (spoken answers without thinking first: the first words come much sooner; on = as typed)
# CLASSIFIER_THINKING=off    (picking a context without thinking)
# STICKY_CONTEXT=off         (on: spoken follow-ups skip the classifier; see the README before turning it on)
# SPECULATIVE_ANSWER=off     (on: the personal answer starts while the classifier runs; see the README before turning it on)
# VOICE_FIRST_CHUNK_CHARS=60 (a long first sentence is spoken from its first clause once it's this long)
# VOICE_MAX_SENTENCES=2     (bare mode, spoken: sentences after the opening reaction, unless they ask for detail)
# VOICE_PUNCTUATION_STYLE=off (bare mode, spoken: on lets replies use ... and — for pauses; an experiment)
# KOKORO_DEVICE=mps          (for npm run voice:up: mps = the M1 GPU, or cpu)
